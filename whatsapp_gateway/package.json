{
  "name": "whatsapp-gateway",
  "version": "1.0.0",
  "description": "WhatsApp Gateway microservice using Baileys",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "axios": "1.16.1",
    "dotenv": "17.4.2",
    "fastify": "5.8.5",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.15.18",
    "@types/qrcode": "1.5.6",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "pino-pretty": "13.1.3",
    "prettier": "3.5.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
